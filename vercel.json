{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/for-business"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/business-auth",
      "destination": "/salon-onboarding-supabase"
    },
    {
      "source": "/login",
      "destination": "/customer-login-register-supabase"
    },
    {
      "source": "/signup",
      "destination": "/customer-login-register-supabase"
    },
    {
      "source": "/venue/admin",
      "destination": "/admin"
    },
    {
      "source": "/venue/admin/bookings",
      "destination": "/bookings"
    },
    {
      "source": "/venue/admin/calendar",
      "destination": "/calendar"
    },
    {
      "source": "/venue/admin/clients",
      "destination": "/clients"
    },
    {
      "source": "/venue/admin/services",
      "destination": "/services"
    },
    {
      "source": "/venue/admin/team",
      "destination": "/team"
    },
    {
      "source": "/venue/admin/reports",
      "destination": "/reports"
    },
    {
      "source": "/venue/admin/settings",
      "destination": "/settings"
    },
    {
      "source": "/venue/admin/messages",
      "destination": "/messages"
    },
    {
      "source": "/venue/admin/team-chat",
      "destination": "/team-chat"
    },
    {
      "source": "/venue/admin/support",
      "destination": "/support"
    },
    {
      "source": "/venue/admin/loyalty",
      "destination": "/loyalty"
    },
    {
      "source": "/venue/admin/gift-cards",
      "destination": "/gift-cards"
    },
    {
      "source": "/venue/admin/addons",
      "destination": "/addons"
    },
    {
      "source": "/venue/admin/checkin",
      "destination": "/checkin"
    },
    {
      "source": "/venue/admin/checkout",
      "destination": "/checkout"
    },
    {
      "source": "/venue/admin/payments",
      "destination": "/payments"
    },
    {
      "source": "/venue/admin/refer-earn",
      "destination": "/refer-earn"
    },
    {
      "source": "/venue/admin/new-booking",
      "destination": "/new-booking"
    },
    {
      "source": "/venue/admin/client",
      "destination": "/client"
    },
    {
      "source": "/venue/admin/booking",
      "destination": "/booking"
    },
    {
      "source": "/venue/admin/team-member",
      "destination": "/team-member"
    },
    {
      "source": "/venue",
      "destination": "/explore"
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy"
    },
    {
      "source": "/terms",
      "destination": "/terms-conditions"
    },
    {
      "source": "/venue/:slug/checkout",
      "destination": "/customer-checkout?venue=:slug"
    },
    {
      "source": "/venue/:slug",
      "destination": "/explore?venue=:slug"
    },
    {
      "source": "/book-now/:slug",
      "destination": "/customer-checkout?venue=:slug"
    },
    {
      "source": "/:slug",
      "destination": "/explore?venue=:slug"
    }
  ]
}
